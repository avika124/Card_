# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required — used to sign session tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Model settings
MODEL=claude-sonnet-4-20250514
MAX_TOKENS=4000

# App settings
APP_BASE_URL=http://localhost:5173
# Origin(s) allowed to call the API (comma-separated). Must match where the React frontend is served from.
FRONTEND_ORIGIN=http://localhost:5173

# Slack notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=compliance@yourcompany.com
